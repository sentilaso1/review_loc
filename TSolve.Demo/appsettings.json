{
  "Jira": {
    "Mode": "Mock",
    "BaseUrl": "",
    "Email": "",
    "ApiToken": "",
    "ProjectKey": "TSOLVE",
    "DoneJql": "statusCategory = Done",
    "BulkLimit": 500,
    "DailyLimit": 10
  },
  "Pipeline": {
    "CandidateQualityThreshold": 55,
    "WeakResolutionMinTokens": 4,
    "PublishedMatchThreshold": 0.18,
    "NearDuplicateThreshold": 0.75,
    "NearDuplicateTitleThreshold": 0.45,
    "ClusterSimilarityThreshold": 0.35,
    "SynthesisConsensusThreshold": 0.45,
    "SynthesisOutlierThreshold": 0.30,
    "PromotionMinEvidence": 3,
    "HighRiskPromotionMinEvidence": 2,
    "PromotionMinAverageQuality": 55,
    "BulkPromotionLimit": 24,
    "DailyPromotionLimit": 3,
    "HighRiskKeywords": ["production", "prod", "payroll", "finance", "maternity", "policy", "admin", "security"],
    "MediumRiskKeywords": ["access", "permission", "laptop", "device", "invoice"]
  },
  "Database": {
    "Url": "",
    "MigrateOnStartup": true
  },
  "Synthesis": {
    "Provider": "Internal",
    "Model": "internal-safe-rewriter-v1",
    "AllowExternalForSensitiveContent": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
